<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared by the WPF app, the agent and the executor.
       module_bindings/ is GENERATED: run scripts/generate-bindings.ps1 after every module change. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IncidentCommand.Client</RootNamespace>
    <!-- DPAPI is Windows-only, and so is this whole system. Silence the cross-platform warnings. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin this to the client SDK version that matches your 2.14.1 server. -->
    <PackageReference Include="SpacetimeDB.ClientSDK" Version="2.*" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>

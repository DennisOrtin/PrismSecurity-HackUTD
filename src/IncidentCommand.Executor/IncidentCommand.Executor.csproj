<Project Sdk="Microsoft.NET.Sdk">
  <!-- Executor.exe            -> run (the ONLY process the egress firewall rule allows out)
       Executor.exe enroll <code> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Executor</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2024.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IncidentCommand.Client\IncidentCommand.Client.csproj" />
  </ItemGroup>
</Project>

<Window x:Class="IncidentCommand.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:v="clr-namespace:IncidentCommand.App.Views"
        Title="Incident Command" Width="1400" Height="900" WindowState="Maximized" FontSize="15"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <DockPanel>
    <!-- Banner: visible on every screen -->
    <Border DockPanel.Dock="Top" Padding="16,12" Background="{StaticResource CardBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Background="{Binding PhaseBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding PhaseText}" FontSize="18" FontWeight="Bold" Foreground="White" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding IncidentLine}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding NextStep}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding UserLine}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding AiLine}" Foreground="{Binding AiBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
          </StackPanel>
          <ui:Button Content="Back to current incident" Margin="0,0,8,0" Command="{Binding BackToCurrentCommand}">
            <ui:Button.Style>
              <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ViewingPast}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:Button.Style>
          </ui:Button>
          <ui:Button Content="Lock" Command="{Binding LockNowCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Errors from any reducer call show here, in words -->
    <Border DockPanel.Dock="Top" Background="{StaticResource DangerBrush}" Padding="16,8">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
        <TextBlock Text="{Binding ErrorText}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <TabControl TabStripPlacement="Left" Margin="0,8,0,0" FontSize="16" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Overview"><v:OverviewView DataContext="{Binding Overview}" /></TabItem>
      <TabItem Header="{Binding ActionsHeader}"><v:ActionsView DataContext="{Binding Actions}" /></TabItem>
      <TabItem Header="Timeline and AI"><v:TimelineView DataContext="{Binding Timeline}" /></TabItem>
      <TabItem Header="Terminal"><v:TerminalView DataContext="{Binding Terminal}" /></TabItem>
      <TabItem Header="Previous incidents"><v:PreviousIncidentsView DataContext="{Binding PreviousIncidents}" /></TabItem>
      <TabItem Header="Laptop posture"><v:PostureView DataContext="{Binding Posture}" /></TabItem>
      <TabItem Header="Settings"><v:SettingsView DataContext="{Binding Settings}" /></TabItem>
    </TabControl>
  </DockPanel>
</Window>

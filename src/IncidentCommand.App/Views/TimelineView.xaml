<UserControl x:Class="IncidentCommand.App.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>

    <!-- Timeline -->
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Timeline" Style="{StaticResource H1}" />
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
        <StackPanel>
          <WrapPanel>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding EntryCategory}" Width="170" Margin="0,0,8,8" />
            <ui:Button Content="Add to timeline" Command="{Binding AddEntryCommand}" IsEnabled="{Binding CanAct}" Margin="0,0,8,8" />
            <ui:Button Content="Write post-incident summary" Command="{Binding RequestSummaryCommand}" IsEnabled="{Binding CanAct}" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBox Text="{Binding EntryText}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsAiDraft}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <ui:Button Content="Accept" Appearance="Primary" Margin="0,0,8,0"
                               Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <ui:Button Content="Reject"
                               Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock>
                      <Run Text="{Binding When, Mode=OneWay}" /> <Run Text="  " /> <Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="  · " />
                      <Run Text="{Binding Author, Mode=OneWay}" Foreground="{Binding AuthorBrush, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Conversation with the AI agents -->
    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Text="Ask the AI" Style="{StaticResource H1}" />
      <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <ui:Button DockPanel.Dock="Right" Content="Send" Appearance="Primary" Command="{Binding SendCommand}" IsEnabled="{Binding CanAct}" Margin="8,0,0,0" />
        <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Text="The AI proposes; it can never act. Everything it suggests goes to the Actions screen for a human decision." />
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Chat}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,12">
                <TextBlock>
                  <Run Text="{Binding Author, Mode=OneWay}" Foreground="{Binding AuthorBrush, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="  " />
                  <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource NeutralBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>

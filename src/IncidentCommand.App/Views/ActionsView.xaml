<UserControl x:Class="IncidentCommand.App.Views.ActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Waiting for your decision" Style="{StaticResource H1}" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="The AI's plan" Style="{StaticResource H2}" />
          <TextBlock Text="{Binding PlanReasoning}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <DockPanel Margin="0,0,0,12">
        <ui:Button DockPanel.Dock="Right" Content="Approve all read-only steps" Command="{Binding ApproveAllReadOnlyCommand}" IsEnabled="{Binding CanAct}" />
        <StackPanel>
          <TextBlock Text="Note to attach to your next decision (optional)" />
          <TextBox Text="{Binding Note}" Margin="0,4,12,0" />
        </StackPanel>
      </DockPanel>

      <ItemsControl ItemsSource="{Binding Pending}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" BorderBrush="{Binding TierBrush}" BorderThickness="2">
              <StackPanel>
                <TextBlock Text="{Binding StepText}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TierText}" Foreground="{Binding TierBrush}" FontWeight="Bold" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ParamsText}" FontFamily="Consolas" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ReviewText}" Foreground="{Binding ReviewBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8">
                  <Run Text="Proposed by" /> <Run Text="{Binding ProposedBy, Mode=OneWay}" /> <Run Text=" · fingerprint" /> <Run Text="{Binding HashShort, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                  <ui:Button Content="{Binding ApproveLabel}" Appearance="Primary" Margin="0,0,8,0" IsEnabled="{Binding Ready}"
                             Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  <ui:Button Content="Deny"
                             Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="What has happened" Style="{StaticResource H1}" Margin="0,24,0,12" />
      <ItemsControl ItemsSource="{Binding History}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Expander Margin="0,0,0,8">
              <Expander.Header>
                <TextBlock>
                  <Run Text="{Binding When, Mode=OneWay}" /> <Run Text="  " />
                  <Run Text="{Binding Status, Mode=OneWay}" Foreground="{Binding StatusBrush, Mode=OneWay}" FontWeight="Bold" /> <Run Text="  " />
                  <Run Text="{Binding Title, Mode=OneWay}" /> <Run Text="  · approved by " /> <Run Text="{Binding By, Mode=OneWay}" />
                </TextBlock>
              </Expander.Header>
              <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="300"
                       VerticalScrollBarVisibility="Auto" />
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>

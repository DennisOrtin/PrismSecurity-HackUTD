<UserControl x:Class="IncidentCommand.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">

      <!-- No incident yet: the one thing to do is open one -->
      <Border>
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasIncident}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="Open an incident" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Muted}" Text="Only the incident commander can open one." Margin="0,0,0,8" />
          <TextBlock Text="Short title" />
          <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
          <TextBlock Text="Severity (4 = critical)" />
          <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding NewSeverity}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,12" />
          <ui:Button Content="Open incident" Appearance="Primary" Command="{Binding OpenIncidentCommand}" IsEnabled="{Binding IsCommander}" />
        </StackPanel>
      </Border>

      <!-- Scope: what data is affected and how -->
      <TextBlock Text="What data is affected" Style="{StaticResource H1}" />
      <DataGrid ItemsSource="{Binding Scope}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140" />
          <DataGridTextColumn Header="Data" Binding="{Binding DataClass}" Width="170" />
          <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120" />
          <DataGridTemplateColumn Header="Status" Width="230">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="Bold" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
          <DataGridTextColumn Header="Updated by" Binding="{Binding UpdatedBy}" Width="140" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- AI-proposed scope changes waiting for a human -->
      <TextBlock Text="Suggested by the AI (not yet accepted)" Style="{StaticResource H2}" />
      <ItemsControl ItemsSource="{Binding ProposedScope}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:Button Content="Accept" Appearance="Primary" Margin="0,0,8,0"
                             Command="{Binding DataContext.AcceptScopeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  <ui:Button Content="Reject"
                             Command="{Binding DataContext.RejectScopeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding Host, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding DataClass, Mode=OneWay}" /> <Run Text=" · " />
                    <Run Text="{Binding Status, Mode=OneWay}" Foreground="{Binding StatusBrush, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Record scope by hand -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Record affected data" Style="{StaticResource H2}" />
          <WrapPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Host" /><TextBox Text="{Binding AssetHost}" Width="160" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Data" /><ComboBox ItemsSource="{Binding DataClasses}" SelectedItem="{Binding AssetClass}" Width="190" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Scope" /><ComboBox ItemsSource="{Binding ScopeLevels}" SelectedItem="{Binding AssetScope}" Width="150" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Status" /><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding AssetStatus}" Width="230" /></StackPanel>
          </WrapPanel>
          <TextBlock Text="Evidence" />
          <TextBox Text="{Binding AssetEvidence}" Margin="0,4,0,12" />
          <ui:Button Content="Save affected data" Command="{Binding AddScopeCommand}" IsEnabled="{Binding CanAct}" />
        </StackPanel>
      </Border>

      <!-- Phase (commander) -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Move the incident to a new phase" Style="{StaticResource H2}" />
          <ItemsControl ItemsSource="{Binding Phases}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ui:Button Content="{Binding}" Margin="0,0,8,8"
                           Command="{Binding DataContext.SetPhaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                           IsEnabled="{Binding DataContext.IsCommander, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl x:Class="IncidentCommand.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>

    <!-- Human terminal: every command is audited with your username -->
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Terminal" Style="{StaticResource H1}" />
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="Runs on the chosen host over SSH. Every command is recorded with your name." Margin="0,0,0,8" />
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" Width="160" Margin="0,0,8,0" />
        <ui:Button DockPanel.Dock="Right" Content="Run" Appearance="Primary" Command="{Binding RunCommand}" IsEnabled="{Binding CanAct}" Margin="8,0,0,0" />
        <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
      </DockPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Commands}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding When, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding Host, Mode=OneWay}" /> <Run Text=" · " />
                    <Run Text="{Binding IssuedBy, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding Status, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,4,0,4" />
                  <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                           MaxHeight="260" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- AI-suggested commands: never executable from here -->
    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Text="Commands the AI suggests" Style="{StaticResource H1}" />
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,12"
                 Text="Written by the AI from data the attacker may control. Copying one only fills in the terminal box; you still decide whether to run it." />
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Suggestions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" BorderBrush="{Binding BannerBrush}" BorderThickness="2">
                <StackPanel>
                  <Border Background="{Binding BannerBrush}" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Banner}" Foreground="White" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Text="{Binding Host}" Style="{StaticResource Muted}" />
                  <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,8" />
                  <TextBlock Text="{Binding Details}" Foreground="{Binding BannerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <TextBlock Text="{Binding Rationale}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                  <ui:Button Content="Copy to terminal (does not run)" HorizontalAlignment="Left"
                             Command="{Binding DataContext.CopyToTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>

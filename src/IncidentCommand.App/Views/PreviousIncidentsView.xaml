<UserControl x:Class="IncidentCommand.App.Views.PreviousIncidentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Closed incidents -->
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Previous incidents" Style="{StaticResource H1}" />
      <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Text" Value="Closed incidents, newest first." />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasIncidents}" Value="False"><Setter Property="Text" Value="No closed incidents yet. Closing an incident (phase Closed) files it here with its report." /></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <ListBox ItemsSource="{Binding Incidents}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4,0,4">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Muted}">
                <Run Text="Closed" /> <Run Text="{Binding Closed, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding Severity, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding Classification}" Style="{StaticResource Muted}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Selected incident -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <DockPanel Margin="0,0,0,12">
          <ui:Button DockPanel.Dock="Right" Content="Show in Overview (reopen from there)" Appearance="Primary"
                     Command="{Binding ShowInOverviewCommand}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Post-incident report" Style="{StaticResource H2}" />
            <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Affected data" Style="{StaticResource H2}" />
        <DataGrid ItemsSource="{Binding Scope}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140" />
            <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="170" />
            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120" />
            <DataGridTemplateColumn Header="Status" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="Bold" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Actions taken" Style="{StaticResource H2}" />
        <DataGrid ItemsSource="{Binding ActionsTaken}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Action" Binding="{Binding Title}" Width="*" />
            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="110" />
            <DataGridTextColumn Header="Approved by" Binding="{Binding ApprovedBy}" Width="180" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Indicators" Style="{StaticResource H2}" />
        <DataGrid ItemsSource="{Binding Indicators}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="240" />
            <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Timeline" Style="{StaticResource H2}" />
        <ItemsControl ItemsSource="{Binding Timeline}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Muted}">
                  <Run Text="{Binding When, Mode=OneWay}" /> <Run Text="  " /> <Run Text="{Binding Category, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding Author, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

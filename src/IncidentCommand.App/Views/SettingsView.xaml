<UserControl x:Class="IncidentCommand.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource H1}" />
      <TextBlock Style="{StaticResource Muted}" Text="Most settings can only be changed by the incident commander." Margin="0,0,0,12" />

      <!-- People -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="People and services" Style="{StaticResource H2}" />
          <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="260">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
          <ui:Button Content="Deactivate selected" Command="{Binding DeactivateCommand}" IsEnabled="{Binding IsCommander}" Margin="0,8,0,16" HorizontalAlignment="Left" />

          <TextBlock Text="Invite someone (they enroll at this laptop with the code)" FontWeight="SemiBold" />
          <WrapPanel Margin="0,8,0,8">
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Name" /><TextBox Text="{Binding InviteName}" Width="220" /></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Role" /><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding InviteRole}" Width="160" /></StackPanel>
            <ui:Button Content="Create invite code" Appearance="Primary" Command="{Binding CreateInviteCommand}" IsEnabled="{Binding IsCommander}" VerticalAlignment="Bottom" />
          </WrapPanel>
          <TextBox Text="{Binding InviteResult, Mode=OneWay}" IsReadOnly="True" FontSize="18" FontFamily="Consolas" TextWrapping="Wrap" BorderThickness="0" />
        </StackPanel>
      </Border>

      <!-- Hosts on the compromised network -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Hosts the executor may reach" Style="{StaticResource H2}" />
          <DataGrid ItemsSource="{Binding Hosts}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="220">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="160" />
              <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70" />
              <DataGridTextColumn Header="Pinned SSH fingerprint" Binding="{Binding Fingerprint}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,8,0,0">
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Name" /><TextBox Text="{Binding HostName}" Width="130" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Address" /><TextBox Text="{Binding HostAddress}" Width="150" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Port" /><TextBox Text="{Binding HostPort}" Width="70" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="SSH fingerprint (SHA256)" /><TextBox Text="{Binding HostFingerprint}" Width="360" /></StackPanel>
          </WrapPanel>
          <ui:Button Content="Save host" Command="{Binding SaveHostCommand}" IsEnabled="{Binding IsCommander}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- Policy -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Policy" Style="{StaticResource H2}" />
          <TextBlock Text="This laptop's address on the network (never allowed as a target)" />
          <DockPanel Margin="0,4,0,12">
            <ui:Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveResponderAddressCommand}" IsEnabled="{Binding IsCommander}" Margin="8,0,0,0" />
            <TextBox Text="{Binding ResponderAddress}" />
          </DockPanel>
          <CheckBox Content="Approve read-only AI steps automatically (they look, never change anything)" IsChecked="{Binding AutoApproveReadOnly}" IsEnabled="{Binding IsCommander}" />
        </StackPanel>
      </Border>

      <!-- Audit -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Audit log" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Muted}" Text="Every change is chained to the one before it. Any edit after the fact breaks the chain." Margin="0,0,0,8" />
          <DockPanel>
            <ui:Button DockPanel.Dock="Left" Content="Verify the chain" Command="{Binding VerifyAuditCommand}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding AuditStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

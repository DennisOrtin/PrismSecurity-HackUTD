<UserControl x:Class="IncidentCommand.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource H1}" />
      <TextBlock Style="{StaticResource Muted}" Text="Most settings can only be changed by the incident commander." Margin="0,0,0,12" />

      <!-- People -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="People and services" Style="{StaticResource H2}" />
          <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="260">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
          <ui:Button Content="Deactivate selected" Command="{Binding DeactivateCommand}" IsEnabled="{Binding IsCommander}" Margin="0,8,0,16" HorizontalAlignment="Left" />

          <TextBlock Text="Invite someone (they enroll at this laptop with the code)" FontWeight="SemiBold" />
          <WrapPanel Margin="0,8,0,8">
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Name" /><TextBox Text="{Binding InviteName}" Width="220" /></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Role" /><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding InviteRole}" Width="160" /></StackPanel>
            <ui:Button Content="Create invite code" Appearance="Primary" Command="{Binding CreateInviteCommand}" IsEnabled="{Binding IsCommander}" VerticalAlignment="Bottom" />
          </WrapPanel>
          <TextBox Text="{Binding InviteResult, Mode=OneWay}" IsReadOnly="True" FontSize="18" FontFamily="Consolas" TextWrapping="Wrap" BorderThickness="0" />
        </StackPanel>
      </Border>

      <!-- Hosts on the compromised network -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Hosts the executor may reach" Style="{StaticResource H2}" />
          <DataGrid ItemsSource="{Binding Hosts}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="220">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="160" />
              <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70" />
              <DataGridTextColumn Header="Pinned SSH fingerprint" Binding="{Binding Fingerprint}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,8,0,0">
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Name" /><TextBox Text="{Binding HostName}" Width="130" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Address" /><TextBox Text="{Binding HostAddress}" Width="150" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="Port" /><TextBox Text="{Binding HostPort}" Width="70" /></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock Text="SSH fingerprint (optional: blank = pinned on first connect)" /><TextBox Text="{Binding HostFingerprint}" Width="360" /></StackPanel>
          </WrapPanel>
          <ui:Button Content="Save host" Command="{Binding SaveHostCommand}" IsEnabled="{Binding IsCommander}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- Policy -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Policy" Style="{StaticResource H2}" />
          <TextBlock Text="This laptop's address on the network (never allowed as a target)" />
          <DockPanel Margin="0,4,0,12">
            <ui:Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveResponderAddressCommand}" IsEnabled="{Binding IsCommander}" Margin="8,0,0,0" />
            <TextBox Text="{Binding ResponderAddress}" />
          </DockPanel>
          <CheckBox Content="Approve read-only AI steps automatically (they look, never change anything)" IsChecked="{Binding AutoApproveReadOnly}" IsEnabled="{Binding IsCommander}" Margin="0,0,0,8" />
          <CheckBox Content="Accept AI timeline entries automatically (phase changes too, except closing the incident)" IsChecked="{Binding AutoAcceptTimeline}" IsEnabled="{Binding IsCommander}" Margin="0,0,0,8" />
          <CheckBox Content="Accept AI findings automatically (affected data; indicators are always recorded)" IsChecked="{Binding AutoAcceptFindings}" IsEnabled="{Binding IsCommander}" Margin="0,0,0,4" />
          <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Everything accepted automatically stays labelled as AI. Actions always need a human." />
        </StackPanel>
      </Border>

      <!-- Built-in services -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Built-in services" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                     Text="Always on unless you switch them off. A switched-off service stays running but the database refuses everything it tries to do." />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <CheckBox Grid.Row="0" Content="Response agent" IsChecked="{Binding AgentEnabled}" IsEnabled="{Binding IsCommander}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AgentStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <CheckBox Grid.Row="1" Content="Reviewer agent" IsChecked="{Binding ReviewerEnabled}" IsEnabled="{Binding IsCommander}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReviewerStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <CheckBox Grid.Row="2" Content="Parser agent" IsChecked="{Binding ParserEnabled}" IsEnabled="{Binding IsCommander}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ParserStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <CheckBox Grid.Row="3" Content="Executor" IsChecked="{Binding ExecutorEnabled}" IsEnabled="{Binding IsCommander}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExecutorStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="Set up missing services now" Command="{Binding SetUpServicesCommand}" IsEnabled="{Binding IsCommander}" Margin="0,0,8,0" />
            <ui:Button Content="Replace service identities" Command="{Binding ReplaceServiceIdentitiesCommand}" IsEnabled="{Binding IsCommander}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- AI -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="AI models (all run on this laptop)" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                     Text="Each agent can use a different model. Changes apply on that agent's next call. LM Studio's address and the exact model IDs are in the settings file below." />
          <WrapPanel>
            <StackPanel Margin="0,0,16,8"><TextBlock Text="Response agent" />
              <ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AgentModel}" Width="230" IsEnabled="{Binding IsCommander}" /></StackPanel>
            <StackPanel Margin="0,0,16,8"><TextBlock Text="Reviewer" />
              <ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ReviewerModel}" Width="230" IsEnabled="{Binding IsCommander}" /></StackPanel>
            <StackPanel Margin="0,0,16,8"><TextBlock Text="Parser" />
              <ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ParserModel}" Width="230" IsEnabled="{Binding IsCommander}" /></StackPanel>
          </WrapPanel>
          <TextBlock Text="LM Studio" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LocalEndpoint, Mode=OneWay}" Style="{StaticResource Muted}" FontFamily="Consolas" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource Muted}"><Run Text="Settings file: " /><Run Text="{Binding SettingsFile, Mode=OneWay}" /></TextBlock>
        </StackPanel>
      </Border>

      <!-- Audit -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Audit log" Style="{StaticResource H2}" />
          <TextBlock Style="{StaticResource Muted}" Text="Every change is chained to the one before it. Any edit after the fact breaks the chain." Margin="0,0,0,8" />
          <DockPanel>
            <ui:Button DockPanel.Dock="Left" Content="Verify the chain" Command="{Binding VerifyAuditCommand}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding AuditStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

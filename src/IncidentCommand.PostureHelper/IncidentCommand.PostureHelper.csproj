<Project Sdk="Microsoft.NET.Sdk">
  <!-- PostureHelper.exe: check-all | fix <check-id> | undo <check-id>, plus an output-file argument.
       check-all runs unelevated; fix and undo are elevated by the app, one UAC prompt each.
       It only knows its fixed list of checks. Anything else exits with an error. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PostureHelper</AssemblyName>
  </PropertyGroup>
</Project>
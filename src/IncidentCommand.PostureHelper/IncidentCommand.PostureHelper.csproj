<Project Sdk="Microsoft.NET.Sdk">
  <!-- PostureHelper.exe check-all --out <file>      (unelevated)
       PostureHelper.exe fix <check-id> --out <file>  (elevated by the app, one UAC prompt)
       PostureHelper.exe undo <check-id> --out <file> (elevated)
       It only knows the fixed list of checks below. Anything else exits with an error. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PostureHelper</AssemblyName>
  </PropertyGroup>
</Project>
